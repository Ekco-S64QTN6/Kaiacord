# Kaiacord environment configuration
# ----------------------------------
# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
#
# Non-secret settings live in config/kaia.yaml, which overrides
# config/default_config.yaml. Environment variables take precedence over both.

# ── Required ────────────────────────────────────────────────────────────────
# Discord bot token — https://discord.com/developers/applications
DISCORD_TOKEN=

# ── Optional: Gemini (background summarisation tasks only) ──────────────────
# Core chat, embeddings, and classification are fully local via Ollama and do
# not need this. Leave blank to run entirely offline.
GEMINI_API_KEY=

# ── Optional: Bluesky ───────────────────────────────────────────────────────
# Also set bluesky.enabled: true in config/kaia.yaml — credentials alone do
# not enable the integration.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# ── Optional: X / Twitter ───────────────────────────────────────────────────
# Also set x_twitter.enabled: true in config/kaia.yaml.
X_USERNAME=
X_EMAIL=
X_PASSWORD=

# ── Optional: Project 1999 forum integration ────────────────────────────────
VBULLETIN_USERNAME=
VBULLETIN_PASSWORD=

# ── Optional: LoRA fine-tuning pipeline (finetune/) ─────────────────────────
HF_TOKEN=
