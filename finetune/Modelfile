FROM ./output/kaia_merged

# Set parameters for Kaia's personality
PARAMETER temperature 0.7
PARAMETER top_p 0.9

# Gemma 3 specific stop tokens (with pipes)
PARAMETER stop "<|start_of_turn|>"
PARAMETER stop "<|end_of_turn|>"
PARAMETER stop "<|begin_of_text|>"
PARAMETER stop "<|endoftext|>"

# Backup stop for the leaked token seen in logs
PARAMETER stop "</end_of_turn>"

# Explicit Chat Template for Gemma 3
TEMPLATE """{{- if .System }}<|start_of_turn|>system
{{ .System }}<|end_of_turn|>
{{- end }}
{{- range .Messages }}<|start_of_turn|>{{ .Role }}
{{ .Content }}<|end_of_turn|>
{{- end }}<|start_of_turn|>model
"""
