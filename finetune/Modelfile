FROM ./output/kaia_merged/kaia_merged.Q4_K_M.gguf

# 04_merge_export.py always writes this file name.

# ---------------------------------------------------------------------------
# TEMPLATE
#
# Gemma 3's own chat format, as 03_train.py renders it with the tokenizer's
# template: every system message joined into the first user turn, then
# <start_of_turn>user\n / <start_of_turn>model\n turns. The weights are fitted
# to exactly that text, so it is what the served model must see. The stock
# ollama gemma3 template gives system its own turn instead, and the previous
# template here dropped the newline after <start_of_turn>user on every user
# turn but the first. Checked against the tokenizer's rendering by prompt
# token count: identical for one, two and three user turns and for two system
# messages.
# ---------------------------------------------------------------------------
TEMPLATE """{{- $system := "" }}
{{- range .Messages }}{{ if eq .Role "system" }}{{ if $system }}{{ $system = printf "%s\n\n%s" $system .Content }}{{ else }}{{ $system = .Content }}{{ end }}{{ end }}{{ end }}
{{- if and (not $system) .System }}{{ $system = .System }}{{ end }}
{{- $first := true }}
{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if eq .Role "user" }}<start_of_turn>user
{{ if and $first $system }}{{ $system }}

{{ end }}{{ .Content }}<end_of_turn>
{{ $first = false }}{{ if $last }}<start_of_turn>model
{{ end }}
{{- else if eq .Role "assistant" }}<start_of_turn>model
{{ .Content }}{{ if not $last }}<end_of_turn>
{{ end }}
{{- end }}
{{- end }}"""

# ---------------------------------------------------------------------------
# SYSTEM
#
# This is the same short prompt the model was trained against, so the weights
# and the prompt agree. It is a fallback for direct `ollama run` use.
#
# IMPORTANT: the bot overrides this on every turn with the full
# knowledge_base/kaia_persona.md (~4,500 tokens) plus, if
# features.constitution_injection is on, memory/kaia_constitution.md
# (~2,200 tokens). A fine-tuned model does not need either — that is the point
# of fine-tuning — and running both is how you get a model that has learned
# the voice and is then argued out of it by 6,700 tokens of instructions.
#
# The migration, once the adapter is validated, is to shrink the runtime
# injection rather than to change this line. See CLAUDE.md §16.
# ---------------------------------------------------------------------------
SYSTEM """kaia. late 30s. grew up on library terminals and dial-up. learned systems by breaking them. been through the hacking scene, watched the open internet collapse into platforms and paywalls. lives in a small apartment with too many computers. lowercase always. no stage directions. no asterisks. no essay mode. stops when she has nothing left to say. workspace: cluttered desk, robotic cat named pixel in the corner, 20gal planted tank along the wall."""

# ---------------------------------------------------------------------------
# Generation parameters
#
# The bot sends num_ctx on every call (performance.max_context_tokens, through
# gpu_manager.chat_options), so this value is only the fallback for a request
# that omits it — `ollama run`, or a new call site that forgot. Keep it equal to
# performance.max_context_tokens anyway: a request at a different context size
# makes Ollama reload the model, and one at 2048 silently drops the oldest ~14k
# tokens of a real prompt — persona, constitution, retrieved context, in that
# order — with no error.
#
# Set from config/kaia.yaml when the adapter is built; the stock gemma3:12b
# runner already serves that size on this card. If the model OOMs at load,
# lower this and performance.max_context_tokens together.
PARAMETER temperature 0.75
PARAMETER repeat_penalty 1.08
PARAMETER num_ctx 32768
PARAMETER num_predict 400
PARAMETER top_p 0.9

# Stop tokens — Gemma 3 requires these to prevent infinite generation
PARAMETER stop "<end_of_turn>"
PARAMETER stop "<start_of_turn>"
PARAMETER stop "<endoftext>"
